table 'Dim Store'
	column store_key
		dataType: int64
		summarizeBy: none
	column store_code
		dataType: string
		summarizeBy: none
	column store_name
		dataType: string
		summarizeBy: none
	column region
		dataType: string
		summarizeBy: none
	column store_type
		dataType: string
		summarizeBy: none
	column is_active
		dataType: boolean
		summarizeBy: none

	partition 'Dim Store' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(PostgreSQL_Server, PostgreSQL_Database),
				gold_dim_store = Source{[Schema="gold",Item="dim_store"]}[Data]
			in
				gold_dim_store
